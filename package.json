{
  "name": "matematicas-vs-zombis-estudiante",
  "version": "4.1.9",
  "description": "Juego educativo Matemáticas vs. Zombis para estudiantes",
  "main": "electron-main.js",
  "author": "Proyecto Matemáticas Aventura",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ec.edu.matematicasvszombis.estudiante.v419",
    "productName": "Matematicas vs Zombis 4.1.9",
    "asar": true,
    "files": [
      "electron-main.js"
    ],
    "extraResources": [
      {
        "from": "app/src/main/assets",
        "to": "www",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "executableName": "INICIAR_MATEMATICAS_VS_ZOMBIS"
    }
  }
}
