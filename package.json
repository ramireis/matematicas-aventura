{
  "name": "matematicas-vs-zombis-estudiante",
  "version": "4.1.5",
  "description": "Juego educativo Matemáticas vs. Zombis para estudiantes",
  "main": "electron-main.js",
  "author": "Proyecto Matemáticas Aventura",
  "license": "UNLICENSED",
  "scripts": {
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ec.edu.matematicasvszombis.estudiante.v415",
    "productName": "Matematicas vs Zombis 4.1.5",
    "asar": true,
    "files": [
      "electron-main.js",
      "app/src/main/assets/www/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Matematicas_vs_Zombis_ESTUDIANTE_4.1.5_WINDOWS_x64_PORTABLE.exe"
    },
    "portable": {
      "artifactName": "Matematicas_vs_Zombis_ESTUDIANTE_4.1.5_WINDOWS_x64_PORTABLE.exe"
    }
  }
}
