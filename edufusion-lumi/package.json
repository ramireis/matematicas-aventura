{
  "name": "edufusion-lumi",
  "version": "5.12.0",
  "private": true,
  "description": "Lumi EDUFUSION Windows",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable --x64",
    "android:prepare": "node prepare-android.js && npx cap add android"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "build": {
    "appId": "ec.edu.edufusion.lumi",
    "productName": "Lumi EDUFUSION",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "package.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lumi_EDUFUSION_5_12_Windows_Portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  }
}
